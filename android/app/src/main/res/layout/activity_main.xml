<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚡ Second Brain"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tablet LLM Server"
        android:textSize="14sp"
        android:alpha="0.6"
        android:layout_marginBottom="32dp" />

    <!-- Model path input -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Model file path"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/etModelPath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="/sdcard/Download/gemma-4-E2B-it.litertlm"
        android:inputType="textUri"
        android:textSize="13sp"
        android:layout_marginBottom="24dp" />

    <!-- Start/Stop button -->
    <Button
        android:id="@+id/btnToggle"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Start Server"
        android:layout_marginBottom="24dp" />

    <!-- Status card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E293B"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STATUS"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#64748B"
            android:letterSpacing="0.1"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Server not running"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="13sp"
            android:textColor="#6366F1"
            android:fontFamily="monospace" />

    </LinearLayout>

</LinearLayout>
