    "checkbox": "3px",
    "todoCheckbox": "1.5px",
    "cellEditor": "6px",
    "notes": "xs = date-picker nav buttons, table checkboxes; sm = small buttons and cells in pickers; md = buttons, rows, inputs; card = menus, cards, callouts, code, images; modal = dialogs, center peek; tooltipCard = selection toolbar, TOC card; search = quick find"
  },

  "duration": {
    "instant": "0.02s ease-in",
    "fast": "0.1s ease-in-out",
    "hoverReveal": "0.1s",
    "toggle": "0.2s",
    "popover": "200ms ease",
    "sidebar": "0.2s",
    "peek": "0.2s ease",
    "chevronRotate": "0.2s ease-out",
    "toast": "0.27s",
    "tooltipFade": "0.05s ease-out",
    "tooltipDelay": "≈500ms (observed)",
    "notes": "instant = row/button hover backgrounds; fast = icon-button hovers; popover = menus (opacity + scale from the anchor-side origin)"
  },

  "zIndex": {
    "viewSettingsPanel": 88,
    "centerPeekBackdrop": 99,
    "sidePeek": 109,
    "peekTopbar": 110,
    "sidebarPeek": 202,
    "modalRoot": 999,
    "toast": 1000000,
    "notes": "Observed values; menus/tooltips render in an overlay container above the page."
  },

