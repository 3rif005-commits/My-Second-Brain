{
  "$meta": {
    "source": "Live Notion (app.notion.com), measured with getComputedStyle via Claude in Chrome, 2026-10-12/13. Viewport 1300x649 / 1300x597, DPR 1.",
    "notes": [
      "Values are exact computed values. Odd alphas such as 0.051 or 0.082 are real; do not round them.",
      "The palette is WARM: light-mode alphas are built on brown-blacks (33,27,23) / (42,28,0) / (28,19,1) / (66,35,3). Pure greys will look subtly wrong.",
      "Neither theme uses real borders on popups. The 1px edge is the last layer of the box-shadow (7% alpha in light, an opaque rgb(56,56,54) ring in dark).",
      "Shadow GEOMETRY differs between themes (not just colour). Use the per-theme values.",
      "Two option palettes exist: color.block (text/highlight colours in pages) and color.option (database select/status pills). They are different.",
      "Where a value says 'not measured', it is an informed placeholder and is marked as such."
    ]
  },

  "font": {
    "ui": "ui-sans-serif, -apple-system, BlinkMacSystemFont, \"Segoe UI Variable Display\", \"Segoe UI\", Helvetica, \"Apple Color Emoji\", \"Noto Sans Arabic\", \"Noto Sans Hebrew\", Arial, sans-serif, \"Segoe UI Emoji\", \"Segoe UI Symbol\"",
    "serif": "Lyon-Text, Georgia, ui-serif, serif",
    "mono": "iawriter-mono, Nitti, Menlo, Courier, monospace",
    "code": "SFMono-Regular, Menlo, Consolas, \"PT Mono\", \"Liberation Mono\", Courier, monospace"
  },

  "type": {
    "pageTitle":        { "size": "40px", "lineHeight": "48px",   "weight": 700, "note": "doc page and full-page row page" },
    "dbTitle":          { "size": "32px", "lineHeight": "38.4px", "weight": 700, "note": "full-page database and row page in a peek" },
    "inlineDbTitle":    { "size": "24px", "lineHeight": "31.2px", "weight": 600 },
    "h1":               { "size": "30px", "lineHeight": "39px",   "weight": 600, "paddingTop": "30px", "paddingBottom": "6px" },
    "h2":               { "size": "24px", "lineHeight": "31.2px", "weight": 600, "paddingTop": "26px", "paddingBottom": "6px" },
    "h3":               { "size": "20px", "lineHeight": "26px",   "weight": 600, "paddingTop": "22px", "paddingBottom": "6px" },
    "body":             { "size": "16px", "lineHeight": "24px",   "weight": 400, "note": "page blocks; block wrapper padding 6px top/bottom, leaf padding 2px" },
    "ui":               { "size": "14px", "lineHeight": "21px",   "weight": 400, "note": "table cells, sidebar, menus use 14px (menus lh 16.8px)" },
    "uiMedium":         { "size": "14px", "lineHeight": "16.8px", "weight": 500, "note": "tabs, buttons, sidebar selected" },
    "small":            { "size": "12px", "lineHeight": "16.8px", "weight": 400, "note": "tooltips, hints, captions" },
    "sectionHeader":    { "size": "12px", "lineHeight": "14.4px", "weight": 500, "note": "menu section headers; sidebar section header uses 12px/16px/500" },
    "badge":            { "size": "11px", "lineHeight": "14.3px", "weight": 500 },
    "openButton":       { "size": "12px", "lineHeight": "18px",   "weight": 500, "letterSpacing": "0.5px", "transform": "uppercase" },
    "calcLabel":        { "size": "10px", "lineHeight": "15px",   "weight": 500, "letterSpacing": "1px", "transform": "uppercase" },
    "code":             { "size": "13.6px", "lineHeight": "20.4px", "weight": 400, "note": "0.85em of body" },
    "boldWeight": 600,
    "smallTextScale": 0.875,
    "serifScale": 1.0625,
    "monoScale": 0.9375
  },

