# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# LLM provider: "openrouter" | "llamacpp" | "gemini"
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-key

# llama.cpp servers (used when LLM_PROVIDER=llamacpp or EMBEDDER_PROVIDER=llamacpp)
LLAMACPP_BASE_URL=http://localhost:8080
LLAMACPP_MODEL=gemma-4-e2b
LLAMACPP_EMBED_URL=http://localhost:8081

# Embedder provider: "llamacpp" | "gemini"
EMBEDDER_PROVIDER=llamacpp

# Google AI (future — only needed when LLM_PROVIDER=gemini or EMBEDDER_PROVIDER=gemini)
GOOGLE_API_KEY=your-google-ai-key

# Internal API key shared between FastAPI and the MCP server
INTERNAL_API_KEY=changeme-internal-key

# App
FRONTEND_URL=http://localhost:3000

# Postgres connection for the databases query engine (asyncpg, not PostgREST).
# Must be the Supabase **pooler** string on port 6543 (Supavisor, transaction
# mode), not the direct 5432 connection:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# services/db/connection.py sets statement_cache_size=0 for exactly this
# reason — transaction-mode pooling can serve each statement from a different
# backend connection, which breaks asyncpg's named prepared statements.
# Only required once the query engine is exercised (Milestone 2+).
DATABASE_URL=

# Notion-databases feature flag; mirrored by the frontend's
# DATABASE_ROWS_ENABLED. Migration 014 (db_row_props) and migration 019
# (the notes_excluding_database_rows view) are both applied in production,
# and the frontend/backend code that uses them has landed — this is now
# safe to flip to true once that code is deployed.
DATABASE_ROWS_ENABLED=false

# Claude — primary provider for the AI layer (services/ai). Model: API_MODEL_ANTHROPIC.
ANTHROPIC_API_KEY=
API_MODEL_ANTHROPIC=claude-haiku-4-5

# Send the source's figure crops to the model during workspace synthesis, on top
# of the extracted text (services/workspace/figures.py). Crops are deduplicated,
# page furniture (a logo on every slide) is dropped, and at most 24 are sent.
# Off by default: on the reference lecture it added nothing the text-only run
# missed and cost colour-budget compliance. Turn it on for diagram-heavy sources.
WORKSPACE_SYNTHESIS_VISION=false
