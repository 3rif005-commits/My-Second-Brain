# Supabase — get these from your project's Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google AI — https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-key

# FastAPI backend (Phase 2+)
FASTAPI_URL=http://localhost:8000

# Notion-databases feature flag. Mirrors the backend's
# `core/config.py: settings.database_rows_enabled`. Leave unset (or anything
# other than the exact string "true") until migration 014 has been applied —
# with it on, every notes surface queries `db_row_props`, which does not
# exist before then. Flipped on in Milestone 2.
DATABASE_ROWS_ENABLED=false
