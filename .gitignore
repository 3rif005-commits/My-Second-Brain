# Python
backend/.venv/
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
backend/*.pyc
backend/.env
.coverage

# Node
# Unanchored, so it also catches the repo-root node_modules/ — the narrower
# frontend/node_modules/ let node_modules/.vite/vitest/**/results.json (a
# vitest run cache) get committed.
node_modules/
frontend/.next/
frontend/.env.local

# Playwright
frontend/test-results/
frontend/playwright-report/
frontend/e2e/.auth/

# OS
.DS_Store
*.log

# Linked worktrees (managed via EnterWorktree/ExitWorktree)
.claude/worktrees/
.clone/
