#!/usr/bin/env bash
# Runs on every `git push` (enabled with: git config core.hooksPath .githooks).
# It stops a push that would break the live deploy or leak a secret:
#   1. no .env file (only .env*.example) and no private key in the pushed files
#   2. frontend TypeScript changed -> `tsc --noEmit` must pass (~45s); Vercel's build fails on it
#   3. backend Python changed     -> the changed files must compile; Render would fail to boot
#   4. a new Supabase migration    -> a reminder only: run it in the SQL editor first
# Emergency skip: git push --no-verify
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)"
ZERO=0000000000000000000000000000000000000000
fail=0
red() { printf '\033[0;31m✗ %s\033[0m\n' "$*"; }
ok()  { printf '\033[0;32m✓ %s\033[0m\n' "$*"; }

changed=""
added=""
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue # deleting a branch
  if [ "$remote_sha" = "$ZERO" ]; then
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null || git rev-list --max-parents=0 "$local_sha" | tail -1)
  else
    base=$remote_sha
  fi
  changed+=$(git diff --name-only --diff-filter=ACMR "$base" "$local_sha")$'\n'
  added+=$(git diff --name-only --diff-filter=A "$base" "$local_sha")$'\n'
done
changed=$(printf '%s' "$changed" | sed '/^$/d' | sort -u)
added=$(printf '%s' "$added" | sed '/^$/d' | sort -u)
[ -z "$changed" ] && exit 0

# 1. secrets
envs=$(printf '%s\n' "$changed" | grep -E '(^|/)\.env' | grep -vE '\.example$' || true)
if [ -n "$envs" ]; then red "an .env file is in this push: $envs"; fail=1; fi
keys=$(cd "$ROOT" && printf '%s\n' "$changed" | while read -r f; do
  [ -f "$f" ] && grep -lE -- '-----BEGIN [A-Z ]*PRIVATE KEY-----' "$f" 2>/dev/null
done)
if [ -n "$keys" ]; then red "a private key is in: $keys"; fail=1; fi

# 2. frontend types
if printf '%s\n' "$changed" | grep -qE '^frontend/.*\.(ts|tsx)$|^frontend/(package\.json|tsconfig\.json)$'; then
  if [ -d "$ROOT/frontend/node_modules" ]; then
    echo "→ frontend type check (tsc)…"
    if (cd "$ROOT/frontend" && npx tsc --noEmit -p . >/tmp/second-brain-prepush-tsc.log 2>&1); then
      ok "frontend types"
    else
      red "frontend type errors (Vercel's build would fail):"
      grep "error TS" /tmp/second-brain-prepush-tsc.log | head -20
      echo "  If an error is inside node_modules, reinstall: cd frontend && npm ci"
      fail=1
    fi
  else
    echo "! frontend/node_modules missing; skipped the type check (run: cd frontend && npm ci)"
  fi
fi

# 3. backend syntax
py=$(printf '%s\n' "$changed" | grep -E '^backend/.*\.py$' || true)
if [ -n "$py" ]; then
  pybin="$ROOT/backend/venv/bin/python"; [ -x "$pybin" ] || pybin=python3
  bad=0
  while read -r f; do
    [ -f "$ROOT/$f" ] || continue
    if ! out=$("$pybin" -m py_compile "$ROOT/$f" 2>&1); then
      printf '%s\n' "$out" | tail -3
      bad=1
    fi
  done <<<"$py"
  if [ $bad = 0 ]; then ok "backend Python compiles"; else red "backend Python does not compile"; fail=1; fi
fi

# 4. migrations
mig=$(printf '%s\n' "$added" | grep -E '^supabase/migrations/.*\.sql$' || true)
if [ -n "$mig" ]; then
  printf '\033[1;33m! new migration(s):\n%s\n  Run each in the Supabase SQL editor BEFORE this deploys, or the live site errors.\033[0m\n' "$mig"
fi

if [ $fail = 1 ]; then
  red "push stopped. Fix the above, commit, push again (emergency only: git push --no-verify)"
  exit 1
fi
exit 0
